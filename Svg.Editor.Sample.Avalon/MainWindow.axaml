<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalon="clr-namespace:Svg.Editor.Sample.Avalon;assembly=Svg.Editor.Sample.Avalon"
        xmlns:avalonia="clr-namespace:Svg.Editor.Avalon;assembly=Svg.Editor.Avalon.Forms"
        xmlns:forms="clr-namespace:Svg.Editor.Avalon.Forms;assembly=Svg.Editor.Avalon.Forms"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Svg.Editor.Sample.Avalon.MainWindow"
        Title="Window">
	<Window.DataContext>
        <avalon:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <forms:ToolCommandsToToolbarItemsConverter x:Key="ToolCommandsToToolbarItemsConverter"/>
    </Window.Resources>
	<StackPanel
		VerticalAlignment="Top"
		HorizontalAlignment="Center"
		Height="800">
		<Menu
			Height="30" Width="1000" HorizontalAlignment="Center"
			VerticalAlignment="Top"
			ItemsSource="{Binding DrawingCanvas.ToolCommands, 
        Converter={StaticResource ToolCommandsToToolbarItemsConverter}}" />

		<avalon:SvgEditorView
			DataContext="{Binding DrawingCanvas}"
			Height="720"
			Width="1080"
			Margin="1"/>
	</StackPanel>
</Window>