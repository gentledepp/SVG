<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Svg.Editor.Avalon.Forms.Dialog.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Svg.Editor.Avalon.Forms.Dialog.Views.ColorPickerDialog" 
             x:DataType="views:ColorPickerDialogViewModel">
     <StackPanel Spacing="5" >
        <ContentControl Content="{Binding Content}" IsVisible="{Binding !!Content}" />
        <ColorView Color="{Binding SelectedColor, Mode=TwoWay}"/>
    </StackPanel>
</UserControl>
