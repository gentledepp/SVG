<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
	  <UseMaui>true</UseMaui>
	  <Nullable>enable</Nullable>
	  <Version>3.0.0.0-maui</Version>
	  <PckageReleaseNotes>
		  #3.0.0.0-maui
		  migrated to maui
	  </PckageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\svg\ic_save.svg" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\svg\ic_save.svg" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="2.88.3" />
		<PackageReference Include="Svg" Version="3.0.0.1-maui1" />
		<PackageReference Include="System.Reactive" Version="4.0.0" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls.Compatibility" Version="2.88.3" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Svg.Editor.Core\Svg.Editor.Core.csproj" />
	  <ProjectReference Include="..\Svg.Editor.Forms\Svg.Editor.Forms.csproj" />
	</ItemGroup>

	<ItemGroup>
		<MauiXaml Update="App.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="EditorPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="MainPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Properties\" />
	</ItemGroup>
</Project>
