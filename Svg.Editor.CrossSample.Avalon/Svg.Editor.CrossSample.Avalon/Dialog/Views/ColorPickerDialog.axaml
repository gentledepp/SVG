<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Svg.Editor.CrossSample.Avalon.Dialog.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Svg.Editor.CrossSample.Avalon.Dialog.Views.ColorPickerDialog" 
             x:DataType="views:ColorPickerDialogViewModel">
    <StackPanel Spacing="5" >
        <ContentControl Content="{Binding Content}" IsVisible="{Binding !!Content}" />
        <ColorPicker Color="{Binding SelectedColor, Mode=TwoWay}"/>

        <TextBlock Name="SelectedColorText"
                   Text="{Binding SelectedColor, Mode=TwoWay}"/>

        <Rectangle Name="ColorPreview"
                   Width="100"
                   Height="100"
                   Fill="{Binding SelectedColor, Mode=TwoWay}"/>
    </StackPanel>
</UserControl>
