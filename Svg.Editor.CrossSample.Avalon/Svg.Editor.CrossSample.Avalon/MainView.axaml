<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:avalon="clr-namespace:Svg.Editor.CrossSample.Avalon;assembly=Svg.Editor.CrossSample.Avalon"
			 xmlns:forms="clr-namespace:Svg.Editor.Avalon.Forms;assembly=Svg.Editor.Avalon.Forms"
             x:Class="Svg.Editor.CrossSample.Avalon.MainView"
			 x:DataType="avalon:MainViewModel">
	<UserControl.DataContext>
		<avalon:MainViewModel />
	</UserControl.DataContext>
	<UserControl.Resources>
		<forms:ToolCommandsToToolbarItemsConverter x:Key="ToolCommandsToToolbarItemsConverter"/>
	</UserControl.Resources>
	<StackPanel
		VerticalAlignment="Top"
		HorizontalAlignment="Center"
		Height="800">
		<Menu
			Height="30" Width="100" HorizontalAlignment="Center"
			VerticalAlignment="Top"
			ItemsSource="{Binding DrawingCanvas.ToolCommands, 
        Converter={StaticResource ToolCommandsToToolbarItemsConverter}}" />

		<avalon:SvgEditorView
			DataContext="{Binding DrawingCanvas}"
			Height="520"
			Width="880"
			Margin="1"/>
	</StackPanel>
</UserControl>
