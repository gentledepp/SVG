<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalon="clr-namespace:Svg.Editor.CrossSample.Avalon;assembly=Svg.Editor.CrossSample.Avalon"
        xmlns:toolBar="clr-namespace:Svg.Editor.Avalon.Forms.ToolBar;assembly=Svg.Editor.Avalon.Forms"
        x:Class="Svg.Editor.CrossSample.Avalon.MainWindow"
        x:DataType="avalon:MainViewModel"
        Title="Window">
    <Window.DataContext>
        <avalon:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <toolBar:ToolCommandsToToolbarItemsConverter x:Key="ToolCommandsToToolbarItemsConverter" />
    </Window.Resources>
    <UserControl>
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <Menu Margin="0 5 0 -15" ItemsSource="{Binding DrawingCanvas.ToolCommands, 
            Converter={StaticResource ToolCommandsToToolbarItemsConverter}}" />

            <avalon:SvgEditorView Grid.Row="1"
                                  DataContext="{Binding DrawingCanvas}"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Grid>
    </UserControl>
   
</Window>